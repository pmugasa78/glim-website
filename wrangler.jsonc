{
	// Glim's website: prerendered SvelteKit pages served as Workers static assets. The Worker
	// script only runs for /api/*, which handles the beta sign-up form.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "glim-website",
	"account_id": "7f5e0b18b3690d66f98da8d2bc747a5c",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-29",
	"observability": { "enabled": true },
	// Served on Glim's own domain; the zone is on the same Cloudflare account.
	"routes": [{ "pattern": "getglim.app", "custom_domain": true }],
	"assets": {
		"directory": "./build",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"],
		// /privacy serves privacy.html; unknown paths get our 404 page.
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "glim-beta",
			"database_id": "d3b1c465-e454-471a-bb1d-cc53188464d3",
			"migrations_dir": "migrations"
		}
	],
	// Limits how often one connection can send the beta form (see worker/index.ts).
	"ratelimits": [
		{ "name": "SIGNUP_LIMIT", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } }
	]
}
