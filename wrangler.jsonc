{
	// Glim's website: prerendered SvelteKit pages served as Workers static assets. The Worker
	// script only runs for /api/*, which handles the beta sign-up form.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "glim-website",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-29",
	"observability": { "enabled": true },
	"assets": {
		"directory": "./build",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"],
		// /privacy serves privacy.html; unknown paths get our 404 page.
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "glim-beta",
			// Replace with the id from `npx wrangler d1 create glim-beta` before the first deploy.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	]
	// Secret, set with `npx wrangler secret put TURNSTILE_SECRET` (and in .dev.vars locally).
}
